  "contract": {
    "borrow_model": "无借券腿(T2 借券被 C6 判死并冻结)",
    "direction_rule": "short 高费率腿 / long 低费率腿(候选行 direction 字段)",
    "entry_rule": {
      "v0-topscore-entry": "pretrigger+complete+无blocker,score 降序取第一(已废弃,仅存量账本)",
