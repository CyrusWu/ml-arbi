      "max_committed_capital_usd": 10000.0,
      "max_gross_notional_usd": 8000.0,
      "registered_capital_usd": 10000.0,
      "tail_note": "双腿隔离保证金;逼空时短腿先爆是主要死法;模拟上限≠损失上限"
    },
    "settlement_model": "无到期(T5 到期结算,当前无数据)",
    "sizing_rule": "每腿=min(配对容量×50%, $4,000);保证金预留=单腿 50%;总占用≥$1,000 才开",
    "slippage_model": "0(L1 可执行价假设,未建模吃深)——显式声明的缺口",
    "theory_basis": "bStock 现货和对应股票永续指向同一股票价值；在永续多头拥挤并支付正资金费时，买现货、空永续可以用同底层对冲价格方向。",
    "thesis": "买入 bStock 现货并做空同底层股票永续，在正资金费窗口收取资金费。",
